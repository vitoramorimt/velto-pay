# Velto Pay - Vercel Production
# Copy these keys to Vercel Project Settings > Environment Variables.
# Never commit real secrets.

# Application URL
# Canonical public URL used for checkout links and Stripe success/cancel URLs.
# While the custom domain is not configured, use the Vercel production URL.
NEXT_PUBLIC_APP_URL=https://velto-pay.vercel.app

# Vercel injects VERCEL_URL automatically. Leave unset in Vercel unless you are
# running the production build outside Vercel and do not set NEXT_PUBLIC_APP_URL.
VERCEL_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Payment provider routing
# Use "sandbox" with Stripe test keys and "production" only with live Stripe keys.
PAYMENT_PROVIDER=stripe
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_WEBHOOK_SECRET=

# Wallet and platform fees
# PLATFORM_FEE_FIXED_AMOUNT accepts cents without separator (249) or currency
# decimal format (2.49 / 2,49). Percentage accepts decimal numbers.
WALLET_SETTLEMENT_DAYS=0
PLATFORM_FEE_FIXED_AMOUNT=0
PLATFORM_FEE_PERCENTAGE=0

# Stripe
STRIPE_SECRET_KEY=sk_test_<replace-me>
STRIPE_PUBLISHABLE_KEY=pk_test_<replace-me>
STRIPE_WEBHOOK_SECRET=whsec_<replace-me>
STRIPE_SUCCESS_URL=https://velto-pay.vercel.app/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://velto-pay.vercel.app/checkout/cancel

# Future generative AI integration. The current Commercial Assistant works
# without OpenAI and does not require this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PWA Push Notifications
# Generate with: corepack pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:suporte@veltopay.com.br

# Server-only Supabase admin key used by notification delivery adapters.
# Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
